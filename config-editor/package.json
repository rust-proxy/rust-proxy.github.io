{
  "name": "config-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "wasm": "wasm-pack build --target web --out-dir pkg --out-name engine --release --locked",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./ui/paraglide --emit-ts-declarations",
    "dev": "npm run wasm && npm run i18n && vite --host 127.0.0.1 --port 8080",
    "check": "npm run i18n && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "npm run i18n && vitest run --project unit",
    "test:browser": "npm run i18n && vitest run --project browser",
    "build": "npm run wasm && npm run check && npm run test && vite build"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.25.4",
    "@inlang/plugin-message-format": "4.4.4",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/prismjs": "1.26.6",
    "@vitest/browser": "5.0.1",
    "@vitest/browser-playwright": "5.0.1",
    "jsdom": "30.1.1",
    "playwright": "1.62.1",
    "prismjs": "1.30.0",
    "svelte": "5.57.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "8.2.2",
    "vitest": "5.0.1",
    "vitest-browser-svelte": "3.1.0",
    "wasm-pack": "0.15.0"
  }
}
